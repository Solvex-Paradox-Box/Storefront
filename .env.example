# DAISY_HAMINJA_API_URL / BDC_PROJECT_API_SERVER_URL:
# Proprietary self-hosted microservice for the Daisy Haminja Post-Agentic Recursive Autonomous Intelligence
# e.g., https://uarefake.space/api/bdc or http://localhost:8080
DAISY_HAMINJA_API_URL=""
BDC_PROJECT_API_SERVER_URL=""

# DAISY_API_TOKEN: Bearer token or key for sovereign bdc-project-api-server authentication
DAISY_API_TOKEN=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PAYPAL_CLIENT_ID: Your PayPal REST App Client ID (Sandbox or Production)
PAYPAL_CLIENT_ID="sb"

# PAYPAL_CLIENT_SECRET: Your PayPal REST App Client Secret
PAYPAL_CLIENT_SECRET=""

# PAYPAL_MODE: sandbox or live
PAYPAL_MODE="sandbox"

# DATABASE_URL / NEON_DATABASE_URL: Neon PostgreSQL connection string
DATABASE_URL=""
NEON_DATABASE_URL=""

